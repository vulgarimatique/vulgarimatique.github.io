---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import site from "../data/site.json";

const base = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}`;
const path = (value = "") => `${base}${value}`.replace(/\/+/g, "/");
const notions = (await getCollection("notions")).sort((a, b) => a.data.title.localeCompare(b.data.title, "fr"));
const findNotion = (id: string) => notions.find((item) => item.id === id);
const featured = ["kubernetes", "chiffrement-encryption", "dns"]
  .map(findNotion)
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
const infographics = ["ip", "cpu-processeur", "chiffrement-encryption"]
  .map(findNotion)
  .filter((item): item is NonNullable<typeof item> => Boolean(item?.data.infographic));
const podcasts = [
  {
    item: findNotion("cloud"),
    title: "Qu’est-ce que le Cloud ?",
    description: "Comprendre le cloud sans se perdre dans les nuages."
  },
  {
    item: findNotion("http-https"),
    title: "TCP/IP en quelques minutes",
    description: "L’essentiel pour comprendre comment circule l’information."
  },
  {
    item: findNotion("phishing"),
    title: "Les bases de la cybersécurité",
    description: "Menaces, parades et bons réflexes au quotidien."
  }
].filter((podcast): podcast is typeof podcast & { item: NonNullable<typeof podcast.item> } => Boolean(podcast.item));
const categories = (await getCollection("categories"))
  .filter((category) => category.data.showHomepage)
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name, "fr"));
const notionCountByCategory = new Map(
  categories.map((category) => [
    category.data.name,
    notions.filter((notion) => notion.data.category === category.data.name).length
  ])
);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>L’informatique, enfin expliquée simplement.</h1>
        <p>Des mots clairs, des exemples concrets et des formats visuels pour comprendre le numérique sans jargon.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={path("glossaire/")}>Découvrir les notions <Icon name="arrow" size={18} /></a>
          <a class="button button-secondary" href={path("infographies/")}><Icon name="chart" size={18} /> Voir les infographies</a>
        </div>
      </div>
      <div class="hero-media">
        <img src={path("assets/hero-network.png")} alt="Réseau illustré reliant serveurs, conteneurs, base de données et sécurité" width="1536" height="1152" />
      </div>
    </div>
  </section>

  <section class="section section-rule" id="notions">
    <div class="container">
      <div class="section-heading">
        <h2>Notions à la une</h2>
        <a class="text-link" href={path("glossaire/")}>Voir toutes les notions <Icon name="arrow" size={17} /></a>
      </div>
      <div class="featured-list">
        {featured.map((item, index) => (
          <a class="featured-item" href={path(`glossaire/${item.id}/`)}>
            <span class="featured-index">0{index + 1}</span>
            <span class="icon-frame">
              <Icon name={index === 0 ? "kubernetes" : index === 1 ? "shield-lock" : "dns"} size={72} strokeWidth={1.35} />
            </span>
            <span class="featured-copy">
              <span class="featured-meta">{item.data.category}</span>
              <h3>{item.data.title}</h3>
              <p>{item.data.summary}</p>
              <span class="text-link">Lire l’explication <Icon name="arrow" size={16} /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section category-showcase" id="categories">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Explorer par catégories</h2>
          <p class="section-intro">Choisissez votre terrain de jeu et avancez notion par notion.</p>
        </div>
      </div>
      <div class="category-rail">
        {categories.map((category) => (
          <a class="category-item" href={path(`categories/${category.id}/`)}>
            <span class="category-icon">
              <Icon name={category.data.icon} size={42} strokeWidth={1.35} />
            </span>
            <span class="category-content">
              <span class="category-count">
                {notionCountByCategory.get(category.data.name) || 0} notion{(notionCountByCategory.get(category.data.name) || 0) > 1 ? "s" : ""}
              </span>
              <h3>{category.data.name}</h3>
              <p>{category.data.description}</p>
              <span class="category-link">Explorer la catégorie <Icon name="arrow" size={16} /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule" id="infographies">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Dernières infographies</h2>
          <p class="section-intro">Comprendre une notion en un regard grâce à des schémas clairs et mémorables.</p>
        </div>
        <a class="text-link" href={path("infographies/")}>Voir toutes les infographies <Icon name="arrow" size={17} /></a>
      </div>
      <div class="infographic-grid homepage-infographics">
        {infographics.map((item) => (
          <a class="media-card" href={path(`glossaire/${item.id}/`)}>
            <span class:list={["media-card-image", `is-${item.data.infographicOrientation || "horizontal"}`]}>
              <img src={path(item.data.infographic!.replace(/^\//, ""))} alt={`Infographie : ${item.data.title}`} loading="lazy" />
            </span>
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
            <span class="text-link"><Icon name="chart" size={15} /> Voir l’infographie <Icon name="arrow" size={15} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section podcast-showcase" id="podcasts">
    <div class="container">
      <div class="section-heading podcast-heading">
        <div>
          <h2>À écouter maintenant</h2>
          <p class="section-intro">Des épisodes courts, directs et sans jargon — le temps d’une pause.</p>
        </div>
        <a class="text-link" href={path("podcasts/")}>Tous les podcasts <Icon name="arrow" size={17} /></a>
      </div>
      <div class="podcast-showcase-grid">
        {podcasts.map((podcast, index) => (
          <article class="podcast-feature">
            <div class="podcast-feature-topline">
              <span>Épisode {String(index + 1).padStart(2, "0")}</span>
              <span>{podcast.item.data.audioDuration} min</span>
            </div>
            <div class="podcast-feature-icon"><Icon name="play" size={22} /></div>
            <h3>{podcast.title}</h3>
            <p>{podcast.description}</p>
            <div class="podcast-wave" aria-hidden="true">
              {[10, 20, 14, 30, 22, 38, 18, 28, 12, 24, 16, 32].map((height) => <i style={`--wave-height:${height}px`}></i>)}
            </div>
            <audio controls preload="metadata">
              <source src={path(podcast.item.data.audio!.replace(/^\//, ""))} type="audio/mp4" />
              Votre navigateur ne peut pas lire cet audio.
            </audio>
            <a class="podcast-detail-link" href={path(`glossaire/${podcast.item.id}/`)}>
              Découvrir l’épisode <Icon name="arrow" size={16} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="flux-rss">
    <div class="container curiosity-panel">
      <div class="curiosity-intro">
        <h2>Restez curieux</h2>
        <p>Choisissez la manière qui vous ressemble pour recevoir les nouvelles explications, infographies et écoutes.</p>
      </div>
      <div class="curiosity-options">
        <div class="curiosity-option">
          <span class="curiosity-icon"><Icon name="mail" size={24} /></span>
          <h3>La newsletter</h3>
          <p>Une sélection éditoriale directement dans votre boîte mail.</p>
          <form class="newsletter-form" data-contact={site.email}>
            <label class="sr-only" for="newsletter-email">Votre adresse e-mail</label>
            <input id="newsletter-email" name="email" type="email" placeholder="vous@exemple.fr" autocomplete="email" required />
            <button class="button button-primary" type="submit">S’inscrire <Icon name="arrow" size={17} /></button>
          </form>
          <span class="form-note" id="newsletter-note" aria-live="polite">Votre messagerie s’ouvrira pour confirmer la demande.</span>
        </div>
        <div class="curiosity-option">
          <span class="curiosity-icon"><Icon name="rss" size={24} /></span>
          <h3>Le flux RSS</h3>
          <p>Chaque nouveauté dans votre lecteur préféré, sans compte ni traçage.</p>
          <a class="button button-secondary" href={path("rss.xml")}>Suivre le flux RSS <Icon name="arrow" size={17} /></a>
          <span class="form-note">Un format ouvert et respectueux de votre vie privée.</span>
        </div>
      </div>
      <div class="newsletter-visual" aria-hidden="true">
        <div class="envelope"><span class="envelope-dot"></span></div>
        <Icon name="paper-plane" size={64} strokeWidth={1.35} />
      </div>
    </div>
  </section>

  <script>
    const newsletterForm = document.querySelector<HTMLFormElement>(".newsletter-form");
    newsletterForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const emailInput = newsletterForm.querySelector<HTMLInputElement>('input[type="email"]');
      const contact = newsletterForm.dataset.contact;
      if (!emailInput?.checkValidity() || !contact) {
        emailInput?.reportValidity();
        return;
      }
      const subject = encodeURIComponent("Inscription à la newsletter Vulgarimatique");
      const body = encodeURIComponent(`Bonjour,\n\nJe souhaite m’inscrire à la newsletter Vulgarimatique avec cette adresse : ${emailInput.value}.\n\nMerci.`);
      window.location.href = `mailto:${contact}?subject=${subject}&body=${body}`;
    });
  </script>
</BaseLayout>
