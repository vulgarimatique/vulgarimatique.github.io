---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}`;
const path = (value = "") => `${base}${value}`.replace(/\/+/g, "/");
const notions = (await getCollection("notions")).sort((a, b) => a.data.title.localeCompare(b.data.title, "fr"));
const featured = notions.filter((item) => item.data.featured).slice(0, 3);
const infographics = notions.filter((item) => item.data.infographic).slice(0, 3);
const podcasts = notions.filter((item) => item.data.audio).slice(0, 3);

const categories = [
  { name: "Réseau & web", icon: "globe", text: "Internet, protocoles, adresse IP, DNS, HTTP…" },
  { name: "Données & IA", icon: "database", text: "Données, bases, algorithmes et apprentissage." },
  { name: "Sécurité", icon: "lock", text: "Chiffrement, attaques, authentification et réflexes." },
  { name: "Développement & outils", icon: "code", text: "Langages, outils, méthodes et contrôle de version." },
  { name: "Cloud, applis & architectures", icon: "cloud", text: "Services, architectures, conteneurs et déploiement." },
  { name: "Matériel & systèmes", icon: "cpu", text: "Ordinateurs, systèmes, mémoire et composants." }
] as const;
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>L’informatique, enfin expliquée simplement.</h1>
        <p>Des mots clairs, des exemples concrets et des formats visuels pour comprendre le numérique sans jargon.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={path("glossaire/")}>Découvrir les notions <Icon name="arrow" size={18} /></a>
          <a class="button button-secondary" href={path("infographies/")}><Icon name="chart" size={18} /> Voir les infographies</a>
        </div>
      </div>
      <div class="hero-media">
        <img src={path("assets/hero-network.png")} alt="Réseau illustré reliant serveurs, conteneurs, base de données et sécurité" width="1536" height="1152" />
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container">
      <div class="section-heading">
        <h2>Notions à la une</h2>
        <a class="text-link" href={path("glossaire/")}>Voir toutes les notions <Icon name="arrow" size={17} /></a>
      </div>
      <div class="featured-list">
        {featured.map((item, index) => (
          <a class="featured-item" href={path(`glossaire/${item.id}/`)}>
            <span class="icon-frame">
              <Icon name={index === 0 ? "cloud" : index === 1 ? "lock" : "globe"} size={46} strokeWidth={1.4} />
            </span>
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
            <span class="text-link">Lire l’explication <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Explorer par catégories</h2>
      </div>
      <div class="category-rail">
        {categories.map((category) => (
          <a class="category-item" href={`${path("glossaire/")}?categorie=${encodeURIComponent(category.name)}`}>
            <Icon name={category.icon} size={44} strokeWidth={1.35} />
            <h3>{category.name}</h3>
            <p>{category.text}</p>
            <span class="category-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container">
      <div class="section-heading">
        <h2>Dernières infographies<br />et podcasts</h2>
        <a class="text-link" href={path("infographies/")}>Voir tout <Icon name="arrow" size={17} /></a>
      </div>
      <div class="media-split">
        <div class="infographic-grid">
          {infographics.map((item) => (
            <a class="media-card" href={path(`glossaire/${item.id}/`)}>
              <span class="media-card-image">
                <img src={path(item.data.infographic!.replace(/^\//, ""))} alt={`Infographie : ${item.data.title}`} loading="lazy" />
              </span>
              <h3>{item.data.title}</h3>
              <p>{item.data.summary}</p>
              <span class="text-link">Voir l’infographie <Icon name="arrow" size={15} /></span>
            </a>
          ))}
        </div>
        <div>
          <h3>Podcasts</h3>
          <div class="podcast-list">
            {podcasts.map((item) => (
              <a class="podcast-row" href={path(`glossaire/${item.id}/`)}>
                <span class="play-button"><Icon name="play" size={18} /></span>
                <span>
                  <h3>{item.data.title}</h3>
                  <p>{item.data.summary}</p>
                </span>
                <span class="podcast-duration">{item.data.audioDuration}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container newsletter">
      <div>
        <h2>Restez curieux</h2>
        <p>Retrouvez régulièrement de nouvelles explications claires, des infographies et des podcasts sélectionnés avec soin.</p>
        <a class="button button-primary" href={path("rss.xml")}>Suivre le flux RSS <Icon name="rss" size={17} /></a>
      </div>
      <div class="newsletter-visual" aria-hidden="true">
        <div class="envelope"><span class="envelope-dot"></span></div>
      </div>
    </div>
  </section>
</BaseLayout>
