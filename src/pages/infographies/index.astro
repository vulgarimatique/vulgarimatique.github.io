---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}`;
const path = (value = "") => `${base}${value}`.replace(/\/+/g, "/");
const items = (await getCollection("notions"))
  .filter((item) => item.data.infographic)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "fr"));
---

<BaseLayout title="Infographies" description="Des infographies pour comprendre visuellement les notions informatiques essentielles.">
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <h1>Voir les idées prendre forme.</h1>
        <p>Des schémas conçus pour saisir une notion en un regard, puis approfondir à votre rythme.</p>
      </div>
      <img class="page-illustration" src={path("assets/hero-network.png")} alt="" width="1536" height="1152" />
    </div>
  </section>
  <section class="section section-rule">
    <div class="container library-grid">
      {items.map((item) => (
        <a class="media-card" href={path(`glossaire/${item.id}/#infographie`)}>
          <span class="media-card-image">
            <img src={path(item.data.infographic!.replace(/^\//, ""))} alt={`Infographie : ${item.data.title}`} loading="lazy" />
          </span>
          <h2>{item.data.title}</h2>
          <p>{item.data.summary}</p>
          <span class="text-link">Ouvrir l’infographie <Icon name="arrow" size={16} /></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
