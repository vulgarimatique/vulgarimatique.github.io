---
interface Props {
  name: "arrow" | "search" | "play" | "chart" | "code" | "globe" | "lock" | "cloud" | "cpu" | "database" | "menu" | "close" | "share" | "rss";
  size?: number;
  strokeWidth?: number;
}

const { name, size = 22, strokeWidth = 1.8 } = Astro.props;
const paths: Record<Props["name"], string> = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>',
  play: '<path d="m9 7 8 5-8 5z" fill="currentColor" stroke="none"/>',
  chart: '<path d="M5 19V9m7 10V5m7 14v-7M3 19h18"/>',
  code: '<path d="m9 7-5 5 5 5m6-10 5 5-5 5m-2-12-2 14"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>',
  lock: '<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/>',
  cloud: '<path d="M6 18h12a4 4 0 0 0 .7-7.9A7 7 0 0 0 5.3 9 4.5 4.5 0 0 0 6 18Z"/>',
  cpu: '<rect x="7" y="7" width="10" height="10" rx="1"/><path d="M9 1v4m6-4v4M9 19v4m6-4v4M1 9h4m-4 6h4m14-6h4m-4 6h4"/>',
  database: '<ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  share: '<circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"/>',
  rss: '<path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/>'
};
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
